@prefix sc:   <https://example.org/smallcity#> .
@prefix mb:   <https://example.org/millbrook/> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#  Millbrook — instance data (ABox) for the Small City ontology.
#  A fictional river town of ~4,800 residents.
#  Geometry: WKT in OGC CRS84 (lon lat). The town spans roughly
#  1.3 km E–W by 1.1 km N–S; the Mill River runs north–south
#  between lon -73.898 and -73.897.
#
#      lat 41.705 ┌──────────┬──────────┬─┬────────┐
#                 │ Northside│ Old Town │R│Eastbank│
#      lat 41.700 ├──Main St─┼──────────┤i├─(bridge)
#                 │ Southgate│ Riverside│v│        │
#      lat 41.695 └──────────┴──────────┴─┴────────┘
#             -73.910     -73.904    -73.898  -73.894
#                     Market St    River Rd  Mill Ln
#################################################################

# ---------------------------------------------------------------
#  City and districts
# ---------------------------------------------------------------
mb:Millbrook a sc:City ;
    sc:name "Millbrook" ;
    sc:population 4800 ;
    sc:households 2010 ;
    sc:areaSqm 1443000.0 ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POLYGON((-73.91 41.695, -73.894 41.695, -73.894 41.705, -73.91 41.705, -73.91 41.695))"^^geo:wktLiteral ] .

# ---------------------------------------------------------------
#  Districts
# ---------------------------------------------------------------
mb:Northside a sc:District ;
    sc:name "Northside" ;
    rdfs:comment "Low/medium-density residential north of Main Street." ;
    sc:partOf mb:Millbrook ;
    sc:population 1800 ;
    sc:households 760 ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POLYGON((-73.91 41.7, -73.904 41.7, -73.904 41.705, -73.91 41.705, -73.91 41.7))"^^geo:wktLiteral ] .

mb:OldTown a sc:District ;
    sc:name "Old Town" ;
    rdfs:comment "Historic town centre: civic buildings, shops and flats." ;
    sc:partOf mb:Millbrook ;
    sc:population 900 ;
    sc:households 450 ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POLYGON((-73.904 41.7, -73.898 41.7, -73.898 41.705, -73.904 41.705, -73.904 41.7))"^^geo:wktLiteral ] .

mb:Southgate a sc:District ;
    sc:name "Southgate" ;
    rdfs:comment "Residential district with the elementary school and fire station." ;
    sc:partOf mb:Millbrook ;
    sc:population 1700 ;
    sc:households 690 ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POLYGON((-73.91 41.695, -73.904 41.695, -73.904 41.7, -73.91 41.7, -73.91 41.695))"^^geo:wktLiteral ] .

mb:Riverside a sc:District ;
    sc:name "Riverside" ;
    rdfs:comment "Riverside park and former mill, partly in the flood zone." ;
    sc:partOf mb:Millbrook ;
    sc:population 300 ;
    sc:households 75 ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POLYGON((-73.904 41.695, -73.898 41.695, -73.898 41.7, -73.904 41.7, -73.904 41.695))"^^geo:wktLiteral ] .

mb:Eastbank a sc:District ;
    sc:name "Eastbank" ;
    rdfs:comment "East of the river: utilities and light industry." ;
    sc:partOf mb:Millbrook ;
    sc:population 100 ;
    sc:households 35 ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POLYGON((-73.897 41.695, -73.894 41.695, -73.894 41.705, -73.897 41.705, -73.897 41.695))"^^geo:wktLiteral ] .

mb:Northside sc:adjacentTo mb:OldTown , mb:Southgate .
mb:OldTown   sc:adjacentTo mb:Riverside .
mb:Southgate sc:adjacentTo mb:Riverside .

# ---------------------------------------------------------------
#  Green and blue infrastructure
# ---------------------------------------------------------------
mb:MillRiver a sc:River ;
    sc:name "Mill River" ;
    sc:partOf mb:Millbrook ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POLYGON((-73.898 41.695, -73.897 41.695, -73.897 41.705, -73.898 41.705, -73.898 41.695))"^^geo:wktLiteral ] .

mb:RiversidePark a sc:Park ;
    sc:name "Riverside Park" ;
    sc:inDistrict mb:Riverside ;
    sc:areaSqm 61000.0 ;
    sc:adjacentTo mb:MillRiver ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POLYGON((-73.9005 41.695, -73.898 41.695, -73.898 41.6985, -73.9005 41.6985, -73.9005 41.695))"^^geo:wktLiteral ] .

mb:MarketSquare a sc:Plaza ;
    sc:name "Market Square" ;
    sc:inDistrict mb:OldTown ;
    sc:areaSqm 2400.0 ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POLYGON((-73.9034 41.7006, -73.903 41.7006, -73.903 41.701, -73.9034 41.701, -73.9034 41.7006))"^^geo:wktLiteral ] .

# ---------------------------------------------------------------
#  Road network — intersections (nodes)
# ---------------------------------------------------------------
mb:I_MainMarket a sc:Intersection ;
    sc:name "Main St & Market St" ;
    sc:partOf mb:Millbrook ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POINT(-73.904 41.7)"^^geo:wktLiteral ] .

mb:I_MainWest a sc:Intersection ;
    sc:name "Main St west end" ;
    sc:partOf mb:Millbrook ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POINT(-73.91 41.7)"^^geo:wktLiteral ] .

mb:I_MainRiver a sc:Intersection ;
    sc:name "Main St & River Rd" ;
    sc:partOf mb:Millbrook ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POINT(-73.898 41.7)"^^geo:wktLiteral ] .

mb:I_MainMill a sc:Intersection ;
    sc:name "Main St & Mill Ln" ;
    sc:partOf mb:Millbrook ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POINT(-73.897 41.7)"^^geo:wktLiteral ] .

mb:I_MarketNorth a sc:Intersection ;
    sc:name "Market St north end" ;
    sc:partOf mb:Millbrook ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POINT(-73.904 41.705)"^^geo:wktLiteral ] .

mb:I_MarketSouth a sc:Intersection ;
    sc:name "Market St south end" ;
    sc:partOf mb:Millbrook ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POINT(-73.904 41.695)"^^geo:wktLiteral ] .

mb:I_RiverNorth a sc:Intersection ;
    sc:name "River Rd north end" ;
    sc:partOf mb:Millbrook ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POINT(-73.898 41.705)"^^geo:wktLiteral ] .

mb:I_RiverSouth a sc:Intersection ;
    sc:name "River Rd south end" ;
    sc:partOf mb:Millbrook ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POINT(-73.898 41.695)"^^geo:wktLiteral ] .

mb:I_MillSouth a sc:Intersection ;
    sc:name "Mill Ln south end" ;
    sc:partOf mb:Millbrook ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "POINT(-73.897 41.695)"^^geo:wktLiteral ] .

# ---------------------------------------------------------------
#  Road network — segments (edges)
# ---------------------------------------------------------------
mb:MainSt_West a sc:RoadSegment ;
    sc:name "Main Street (west)" ;
    sc:partOf mb:Millbrook ;
    sc:hasRoadClass sc:Arterial ;
    sc:startsAt mb:I_MainWest ;
    sc:endsAt mb:I_MainMarket ;
    sc:lengthM 498.0 ;
    sc:lanes 2 ;
    sc:speedLimitKmh 50 ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "LINESTRING(-73.91 41.7, -73.904 41.7)"^^geo:wktLiteral ] .

mb:MainSt_East a sc:RoadSegment ;
    sc:name "Main Street (east)" ;
    sc:partOf mb:Millbrook ;
    sc:hasRoadClass sc:Arterial ;
    sc:startsAt mb:I_MainMarket ;
    sc:endsAt mb:I_MainRiver ;
    sc:lengthM 498.0 ;
    sc:lanes 2 ;
    sc:speedLimitKmh 40 ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "LINESTRING(-73.904 41.7, -73.898 41.7)"^^geo:wktLiteral ] .

mb:MillBridge a sc:Bridge ;
    sc:name "Mill Bridge" ;
    sc:partOf mb:Millbrook ;
    sc:hasRoadClass sc:Arterial ;
    sc:startsAt mb:I_MainRiver ;
    sc:endsAt mb:I_MainMill ;
    sc:lengthM 83.0 ;
    sc:lanes 2 ;
    sc:speedLimitKmh 40 ;
    sc:crosses mb:MillRiver ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "LINESTRING(-73.898 41.7, -73.897 41.7)"^^geo:wktLiteral ] .

mb:MarketSt_North a sc:RoadSegment ;
    sc:name "Market Street (north)" ;
    sc:partOf mb:Millbrook ;
    sc:hasRoadClass sc:Collector ;
    sc:startsAt mb:I_MainMarket ;
    sc:endsAt mb:I_MarketNorth ;
    sc:lengthM 556.0 ;
    sc:lanes 2 ;
    sc:speedLimitKmh 40 ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "LINESTRING(-73.904 41.7, -73.904 41.705)"^^geo:wktLiteral ] .

mb:MarketSt_South a sc:RoadSegment ;
    sc:name "Market Street (south)" ;
    sc:partOf mb:Millbrook ;
    sc:hasRoadClass sc:Collector ;
    sc:startsAt mb:I_MainMarket ;
    sc:endsAt mb:I_MarketSouth ;
    sc:lengthM 556.0 ;
    sc:lanes 2 ;
    sc:speedLimitKmh 40 ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "LINESTRING(-73.904 41.7, -73.904 41.695)"^^geo:wktLiteral ] .

mb:RiverRd_North a sc:RoadSegment ;
    sc:name "River Road (north)" ;
    sc:partOf mb:Millbrook ;
    sc:hasRoadClass sc:Local ;
    sc:startsAt mb:I_MainRiver ;
    sc:endsAt mb:I_RiverNorth ;
    sc:lengthM 556.0 ;
    sc:lanes 2 ;
    sc:speedLimitKmh 30 ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "LINESTRING(-73.898 41.7, -73.898 41.705)"^^geo:wktLiteral ] .

mb:RiverRd_South a sc:RoadSegment ;
    sc:name "River Road (south)" ;
    sc:partOf mb:Millbrook ;
    sc:hasRoadClass sc:Local ;
    sc:startsAt mb:I_MainRiver ;
    sc:endsAt mb:I_RiverSouth ;
    sc:lengthM 556.0 ;
    sc:lanes 2 ;
    sc:speedLimitKmh 30 ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "LINESTRING(-73.898 41.7, -73.898 41.695)"^^geo:wktLiteral ] .

mb:MillLane a sc:RoadSegment ;
    sc:name "Mill Lane" ;
    sc:partOf mb:Millbrook ;
    sc:hasRoadClass sc:Local ;
    sc:startsAt mb:I_MainMill ;
    sc:endsAt mb:I_MillSouth ;
    sc:lengthM 556.0 ;
    sc:lanes 2 ;
    sc:speedLimitKmh 30 ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "LINESTRING(-73.897 41.7, -73.897 41.695)"^^geo:wktLiteral ] .

# Node adjacency (materialised from startsAt/endsAt for convenience)
mb:I_MainWest sc:connectsTo mb:I_MainMarket .
mb:I_MainMarket sc:connectsTo mb:I_MainRiver .
mb:I_MainRiver sc:connectsTo mb:I_MainMill .
mb:I_MainMarket sc:connectsTo mb:I_MarketNorth .
mb:I_MainMarket sc:connectsTo mb:I_MarketSouth .
mb:I_MainRiver sc:connectsTo mb:I_RiverNorth .
mb:I_MainRiver sc:connectsTo mb:I_RiverSouth .
mb:I_MainMill sc:connectsTo mb:I_MillSouth .

# ---------------------------------------------------------------
#  Utility networks
# ---------------------------------------------------------------
mb:PowerGrid a sc:PowerNetwork ; sc:name "Millbrook distribution grid" .
mb:WaterSupply a sc:WaterNetwork ; sc:name "Millbrook water supply" .

